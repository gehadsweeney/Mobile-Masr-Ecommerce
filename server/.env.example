# Server environment variables (example values)
PORT=3000

# Production MongoDB connection (replace <user>,<pass>,<cluster>,<dbname>)
# Example: mongodb+srv://user:pass@cluster0.mongodb.net/your-db
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>

# Swagger / API docs base URL
swaggerURL=http://localhost:3000

# JWT secret
JWT_SECRET=your_jwt_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI (server-side key)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: legacy fallback name for OpenAI key
OPENAI_KEY=sk-your-openai-key-here
